# Whitelist for iOS on Google Pixel Fold (Tensor G2 / felix)
/*
!/.gitignore
!/README.md
!/TENSOR_G2_PORTING_MASTER_GUIDE.md
!/LICENSE
!/baremetal_loader/
!/tools/
!/xnu/

# Baremetal loader build artifacts
/baremetal_loader/*.o
/baremetal_loader/*.elf
/baremetal_loader/*.bin
/baremetal_loader/*.lz4
/baremetal_loader/*.img
/baremetal_loader/Image
/baremetal_loader/kernel.macho
/baremetal_loader/test_*.s
/baremetal_loader/chkpt_test.s
/baremetal_loader/tramp.s

# Tools generated artifacts
/tools/*.simg
/tools/*.img

# Temporary and editor files
__pycache__/
*.pyc
*~
*.orig
*.rej
.DS_Store
